page{background:#f7f8f2;color:#263325;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.65}view,text,button,input,textarea{box-sizing:border-box}button{margin:0;border-radius:18rpx;font-size:28rpx;font-weight:600;line-height:1.4;padding:25rpx 28rpx}button::after{border:0}button[disabled]{opacity:.45}input{height:80rpx;font-size:28rpx}textarea{width:100%;font-size:28rpx;line-height:1.7}image{display:block}.page{padding:32rpx 32rpx 70rpx}.eyebrow{font-size:21rpx;letter-spacing:5rpx;color:#738065}.title{font-size:52rpx;line-height:1.3;font-weight:650;letter-spacing:-2rpx}.subtitle{color:#7b8274;margin-top:14rpx;font-size:25rpx}.section{margin-top:38rpx}.section-title{font-size:32rpx;font-weight:650}.row{display:flex;align-items:center;gap:18rpx}.between{justify-content:space-between}.grow{flex:1;min-width:0}.muted{color:#7d8577}.small{font-size:23rpx}.primary{background:#344d2c;color:#fff}.secondary{background:#e8eddd;color:#334a2c}.ghost{background:transparent;color:#53644a;padding:14rpx 20rpx}.danger{background:#f6e8e1;color:#a44a32}.card{background:white;border:1rpx solid #e7eadf;border-radius:24rpx;overflow:hidden}.pad{padding:28rpx}.label{font-size:24rpx;font-weight:600;color:#53604e;margin-bottom:12rpx}.field{background:#fff;border:1rpx solid #e0e6d7;border-radius:16rpx;padding:0 22rpx;margin-bottom:22rpx}.field.area{padding:20rpx 22rpx}.pill{padding:10rpx 25rpx;background:#eef0e7;border-radius:50rpx;color:#737c69;font-size:24rpx}.pill.active{background:#344d2c;color:#fff}.notice{padding:18rpx 22rpx;border-radius:14rpx;background:#eef1e5;color:#71805d;font-size:23rpx;margin:22rpx 0}.warning{background:#fcf0de;color:#966628}.empty{text-align:center;padding:90rpx 26rpx;color:#7e8973}.error{color:#a24d38;background:#fff0e8;padding:20rpx;border-radius:16rpx;margin:20rpx 0}.divider{height:1rpx;background:#e9ede2;margin:24rpx 0}.tag{font-size:20rpx;display:inline-block;background:#eef2e6;color:#577346;padding:3rpx 12rpx;border-radius:8rpx}.sticky{position:fixed;bottom:0;left:0;right:0;z-index:9;background:#ffffffed;border-top:1rpx solid #e7ebdf;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));display:flex;gap:18rpx}.sticky button{flex:1}.with-footer{padding-bottom:180rpx}.metric{font-size:44rpx;font-weight:600;line-height:1.25}.metric text{font-size:23rpx;font-weight:400;margin-left:8rpx}.metrics{display:flex;gap:56rpx;margin:28rpx 0}.metrics .muted{font-size:22rpx;margin-top:8rpx}.route-name{font-size:32rpx;font-weight:600}.route-meta{font-size:23rpx;color:#7f8976;margin-top:10rpx}.spacer{height:24rpx}.link{color:#4b693e}.avatar{width:88rpx;height:88rpx;border-radius:50%;background:#e6ecd9;display:flex;align-items:center;justify-content:center;color:#536c3d;font-size:35rpx}.btn-small{font-size:24rpx;padding:18rpx 24rpx}.wrap{flex-wrap:wrap}.pre{white-space:pre-wrap}.step{display:flex;gap:22rpx;margin:22rpx 0}.step-num{background:#e7ecd9;color:#4f643c;border-radius:50%;width:48rpx;height:48rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center}.chips{display:flex;gap:14rpx;flex-wrap:wrap;margin:20rpx 0}
