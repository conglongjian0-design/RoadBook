page{min-height:100%;background:#121212;color:#f5f7f5;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Helvetica Neue",sans-serif;font-size:28rpx}
view,text,button,input,textarea{box-sizing:border-box}button{margin:0;border-radius:18rpx;font-size:28rpx;font-weight:700;line-height:1.4}button::after{border:0}input,textarea{color:#f5f7f5;font-size:28rpx}input::placeholder,textarea::placeholder{color:#626a64}image{display:block}
.page{min-height:100vh;padding:36rpx 32rpx 70rpx}.with-footer{padding-bottom:180rpx}.row{display:flex;align-items:center;gap:18rpx}.between{justify-content:space-between}.wrap{flex-wrap:wrap}.grow{flex:1;min-width:0}.section{margin-top:34rpx}.section-title{color:#f6f8f6;font-size:32rpx;font-weight:750}.title{color:#f7faf7;font-size:58rpx;font-weight:800;line-height:1.14;letter-spacing:-2rpx}.subtitle{margin-top:12rpx;color:#8e9790;font-size:26rpx;line-height:1.65}.eyebrow{color:#1ed760;font-size:20rpx;font-weight:700;letter-spacing:4rpx}.small{font-size:23rpx}.muted{color:#808981}.pre{white-space:pre-wrap}
.card{overflow:hidden;border:1rpx solid #252b27;border-radius:26rpx;background:#141815;box-shadow:0 18rpx 44rpx rgba(0,0,0,.22)}.pad{padding:28rpx}.divider{height:1rpx;margin:34rpx 0;background:#252b27}.tag{display:inline-block;padding:8rpx 16rpx;border-radius:999rpx;background:rgba(32,229,116,.12);color:#54ef92;font-size:21rpx;font-weight:650}.route-name{color:#f7faf7;font-size:35rpx;font-weight:750;line-height:1.35}.route-meta{margin-top:13rpx;color:#89928b;font-size:23rpx}
.primary,.secondary,.ghost{min-height:84rpx;padding:0 28rpx;line-height:84rpx}.primary{background:#1ed760;color:#07110b;box-shadow:0 12rpx 34rpx rgba(32,229,116,.18)}.primary[disabled]{background:#26342b;color:#738078;opacity:1;box-shadow:none}.secondary{border:1rpx solid #354039;background:#1b211d;color:#eef3ef}.ghost{min-height:64rpx;padding:0 20rpx;background:transparent;color:#aab3ac;line-height:64rpx}.ghost[disabled]{color:#515852}.danger{background:#2a1715;color:#ef8b7d}
.chips{display:flex;gap:14rpx;margin:26rpx 0;overflow-x:auto;white-space:nowrap}.pill{flex:none;padding:14rpx 27rpx;border:1rpx solid #303732;border-radius:999rpx;background:#151a17;color:#929b94;font-size:24rpx}.pill.active{border-color:#1ed760;background:#1ed760;color:#07110b;font-weight:700}
.notice{margin:24rpx 0;padding:21rpx 24rpx;border:1rpx solid #29342d;border-radius:18rpx;background:#151c17;color:#9faa9f;font-size:24rpx;line-height:1.6}.warning{border-color:#463a22;background:#1f1a10;color:#d6bc78}.error{margin:24rpx 0;padding:22rpx;border:1rpx solid #633d38;border-radius:18rpx;background:#251513;color:#f29a8b}.empty{padding:100rpx 26rpx;color:#7d877f;text-align:center;line-height:1.8}
.field{width:100%;min-height:88rpx;margin-bottom:22rpx;padding:20rpx 22rpx;border:1rpx solid #2b332e;border-radius:18rpx;background:#141915}.field input,.field textarea{width:100%}.field.area{min-height:220rpx}.field.area textarea{height:180rpx}.label{margin-bottom:12rpx;color:#aab2ac;font-size:24rpx;font-weight:600}
.metrics{display:flex;margin:34rpx 0;padding:25rpx 0;border-top:1rpx solid #242a26;border-bottom:1rpx solid #242a26}.metrics>view{flex:1;min-width:0}.metrics .muted{margin-top:8rpx;font-size:21rpx}.metric{color:#f6f9f6;font-size:43rpx;font-weight:800;line-height:1.25}.metric text{margin-left:5rpx;color:#8c968e;font-size:22rpx;font-weight:500}
.step{display:flex;align-items:center;gap:20rpx;margin:18rpx 0}.step-num{display:flex;flex:none;align-items:center;justify-content:center;width:50rpx;height:50rpx;border:1rpx solid #36503e;border-radius:50%;background:#19241c;color:#50ed8e;font-size:23rpx;font-weight:700}.avatar{display:flex;flex:none;align-items:center;justify-content:center;width:104rpx;height:104rpx;overflow:hidden;border:2rpx solid #2ce77b;border-radius:50%;background:#1c2920;color:#35e981;font-size:36rpx}.sticky{position:fixed;z-index:9;right:0;bottom:0;left:0;display:flex;gap:18rpx;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));border-top:1rpx solid #222824;background:rgba(9,12,10,.96)}.sticky button{flex:1}
