<view class="page explore-page">
  <view class="topbar">
    <view><view class="eyebrow">ROADBOOK / EXPLORE</view><view class="title section">探索路书</view><view class="subtitle">规划下一段骑行旅程</view></view>
    <button class="create" bindtap="create">＋</button>
  </view>
  <view class="notice" wx:if="{{isDemo}}">体验模式 · 示例路线仅供演示，创建内容保存在本机</view>
  <view class="search row"><text class="search-icon">⌕</text><input class="grow" placeholder="搜索路线或城市" value="{{keyword}}" bindinput="search" confirm-type="search" bindconfirm="refresh"/><text class="search-tail">筛选</text></view>
  <view class="chips"><view wx:for="{{modes}}" wx:key="value" class="pill {{mode===item.value?'active':''}}" data-mode="{{item.value}}" bindtap="filter">{{item.label}}</view></view>
  <view class="row between section-heading"><view><view class="section-title">热门路书</view><view class="subtitle">来自骑行者的真实路线</view></view><text class="accent small">{{routes.length}} 条</text></view>
  <view class="error" wx:if="{{error}}">{{error}}<button class="ghost" bindtap="refresh">重新加载</button></view>
  <view class="route card {{index===0?'featured':''}}" wx:for="{{routes}}" wx:key="_id" data-id="{{item._id}}" bindtap="open">
    <view class="cover"><route-thumb segments="{{item.segments}}"/><view class="cover-badge" wx:if="{{index===0}}">本周精选</view></view>
    <view class="pad">
      <view class="row between"><text class="tag">{{item.modeLabel}} · {{item.city||'未标注城市'}}</text><text class="small muted" wx:if="{{item.isDemo}}">DEMO</text></view>
      <view class="route-name">{{item.title}}</view>
      <view class="route-stats"><view><text class="stat-value">{{item.distanceLabel}}</text><text class="stat-unit"> km</text><view class="stat-label">路线距离</view></view><view class="author"><text class="avatar-dot">骑</text><text>{{item.authorName}}</text></view><text class="arrow">↗</text></view>
    </view>
  </view>
  <view class="empty" wx:if="{{!loading&&!error&&!routes.length}}">这里还没有路书<view class="small">换个关键词，或分享你的第一条路线</view></view>
  <view class="empty small" wx:if="{{loading}}">正在寻找好路线…</view>
  <button wx:if="{{hasMore&&!loading}}" class="secondary more" bindtap="loadMore">加载更多</button>
  <view class="footnote" wx:if="{{routes.length}}">KEEP MOVING · KEEP EXPLORING</view>
</view>
