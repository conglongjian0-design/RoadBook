.explore-page{padding-top:46rpx}.topbar{display:flex;align-items:flex-start;justify-content:space-between}.topbar .section{margin-top:20rpx}.create{width:82rpx;height:82rpx;padding:0;border:1rpx solid #3b493f;border-radius:50%;background:#171d19;color:#1ed760;font-size:45rpx;line-height:78rpx}.search{height:92rpx;margin-top:38rpx;padding:0 22rpx;border:1rpx solid #29312c;border-radius:22rpx;background:#141916}.search-icon{color:#1ed760;font-size:40rpx}.search-tail{padding-left:20rpx;border-left:1rpx solid #303732;color:#788179;font-size:22rpx}.section-heading{margin-top:38rpx}.accent{color:#1ed760}.route{margin-top:26rpx}.route.featured{border-color:#31523c}.cover{position:relative}.cover-badge{position:absolute;top:20rpx;left:20rpx;padding:9rpx 15rpx;border-radius:999rpx;background:#1ed760;color:#07110b;font-size:20rpx;font-weight:750}.route-name{margin-top:19rpx}.route-stats{display:flex;align-items:flex-end;margin-top:23rpx;padding-top:20rpx;border-top:1rpx solid #252c27}.stat-value{font-size:34rpx;font-weight:800}.stat-unit,.stat-label{color:#838c85;font-size:20rpx}.author{display:flex;flex:1;align-items:center;justify-content:flex-end;gap:10rpx;color:#98a099;font-size:22rpx}.avatar-dot{display:flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;border-radius:50%;background:#263129;color:#4ced8d}.arrow{margin-left:20rpx;color:#1ed760;font-size:32rpx}.more{width:100%;margin-top:24rpx}.footnote{padding:55rpx 0 10rpx;color:#4d5550;font-size:18rpx;letter-spacing:4rpx;text-align:center}
