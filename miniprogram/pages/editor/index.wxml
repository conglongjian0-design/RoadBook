<view class="page with-footer">
 <view class="eyebrow">MAKE YOUR OWN WAY</view><view class="title section">{{id?'编辑这条路':'留下一条好路线'}}</view><view class="subtitle">从一份轨迹，或一个想去的地方开始。</view>
 <view class="notice" wx:if="{{isDemo}}">体验模式 · 内容仅保存在本机，手动规划只生成示意连线</view>
 <view class="chips"><view class="pill {{tab==='plan'?'active':''}}" data-tab="plan" bindtap="switchTab">手动规划</view><view class="pill {{tab==='import'?'active':''}}" data-tab="import" bindtap="switchTab">导入 GPX</view></view>
 <view class="card pad" wx:if="{{tab==='import'}}"><view class="section-title">带上你已有的路线</view><view class="subtitle">从微信聊天中选择 GPX 文件。最多 3 MB、8000 个轨迹点。</view><button class="secondary section" bindtap="importFile">＋ 选择 GPX 文件</button><view class="small muted section">iPhone「文件」中的 GPX，可先发送给文件传输助手，再在这里选择。</view></view>
 <view wx:else class="card pad"><view class="section-title">想经过哪些地方？</view><view class="subtitle">按顺序添加地点，最后一个地点为终点。</view><view class="stop" wx:for="{{waypoints}}" wx:key="index"><view class="row"><view class="step-num">{{index+1}}</view><view class="grow" data-index="{{index}}" bindtap="replaceStop"><view>{{item.name}}</view><view class="small muted">{{index===0?'起点':index===waypoints.length-1?'终点':'途经点'}} · 点击更换</view></view><button class="ghost" data-index="{{index}}" bindtap="moveUp" wx:if="{{index>0}}">↑</button><button class="ghost" data-index="{{index}}" bindtap="removeStop">×</button></view></view><button class="secondary section" bindtap="addStop" wx:if="{{waypoints.length<20}}">＋ {{waypoints.length===0?'添加起点':'添加下一个地点'}}</button><button class="primary section" bindtap="plan" disabled="{{waypoints.length<2||planning}}" loading="{{planning}}">{{planning?'正在规划…':'生成路线'}}</button></view>
 <view class="error" wx:if="{{error}}">{{error}}</view>
 <view class="section" wx:if="{{segments.length}}"><route-thumb segments="{{segments}}"/><view class="notice {{source==='demo'?'warning':''}}">{{source==='demo'?'仅为地点间示意连线，不是实际道路。':'已保存完整轨迹，发布前请检查路线。'}} {{distanceLabel}} km · {{pointCount}} 个轨迹点</view></view>
 <view class="section"><view class="label">路线名称</view><view class="field"><input value="{{title}}" maxlength="60" placeholder="给这次出发起个名字" data-field="title" bindinput="input"/></view><view class="label">出行方式</view><view class="chips"><view wx:for="{{modes}}" wx:key="value" class="pill {{mode===item.value?'active':''}}" data-mode="{{item.value}}" bindtap="setMode">{{item.label}}</view></view><view class="label">所在城市（选填）</view><view class="field"><input value="{{city}}" maxlength="30" placeholder="例如：上海" data-field="city" bindinput="input"/></view><view class="label">路线说明（选填）</view><view class="field area"><textarea value="{{description}}" maxlength="2000" placeholder="沿途的风景、补给点，或想提醒同行者的事…" data-field="description" bindinput="input"/></view></view>
 <view class="card pad row between"><view class="grow"><view class="section-title">公开这本路书</view><view class="subtitle">{{visibility==='public'?'所有人可查看、分享和导出':'仅自己可见，分享链接也不会开放权限'}}</view></view><switch checked="{{visibility==='public'}}" color="#536d3d" bindchange="visibility"/></view>
 <view class="sticky"><button class="primary" bindtap="save" disabled="{{saving||planning||loading}}" loading="{{saving}}">{{saving?'正在保存…':visibility==='public'?'保存并公开':'保存为私密路书'}}</button></view>
</view>
