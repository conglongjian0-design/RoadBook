.detail-shell{background:#121212}.map-wrap{position:relative;height:590rpx;overflow:hidden}.map{width:100%;height:100%;filter:saturate(.35) brightness(.72) contrast(1.15)}.map-shade{position:absolute;right:0;bottom:0;left:0;height:170rpx;background:linear-gradient(transparent,#121212)}.map-live{position:absolute;top:24rpx;left:26rpx;padding:10rpx 15rpx;border:1rpx solid #344038;border-radius:999rpx;background:rgba(8,12,9,.82);color:#a1aaa3;font-size:18rpx;letter-spacing:2rpx}.map-live text{display:inline-block;width:9rpx;height:9rpx;margin-right:8rpx;border-radius:50%;background:#1ed760;box-shadow:0 0 14rpx #1ed760}.detail{position:relative;margin-top:-34rpx;padding-top:18rpx;border-radius:32rpx 32rpx 0 0;background:#121212}.visibility{color:#727c74}.route-title{margin-top:26rpx;font-size:52rpx}.author-line{display:flex;align-items:center;gap:15rpx;margin-top:24rpx}.author-avatar{display:flex;align-items:center;justify-content:center;width:56rpx;height:56rpx;border-radius:50%;background:#1d2a21;color:#1ed760;font-weight:700}.section-head{margin-top:42rpx}.timeline{margin-top:12rpx;padding-left:8rpx}.description{margin-top:20rpx;color:#9ca59e;font-size:27rpx;line-height:1.8}.action-grid,.owner-actions{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.action-grid button,.owner-actions button{width:100%}.delete{color:#ef8b7d}.sticky .primary text{margin-left:8rpx;font-size:32rpx}
