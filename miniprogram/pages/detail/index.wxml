<view class="error" wx:if="{{error}}">{{error}}<button class="ghost" bindtap="reload">重新加载</button></view>
<view wx:if="{{route}}" class="with-footer detail-shell">
  <view class="map-wrap">
    <map class="map" latitude="{{center.latitude}}" longitude="{{center.longitude}}" scale="12" polyline="{{polylines}}" markers="{{markers}}" include-points="{{includePoints}}" enable-scroll enable-zoom show-scale></map>
    <view class="map-shade"></view><view class="map-live"><text></text> LIVE ROUTE</view>
  </view>
  <view class="page detail">
    <view class="row between"><text class="tag">{{route.modeLabel}} · {{route.city||'未标注城市'}}</text><text class="small visibility">{{route.visibility==='public'?'公开路书':'仅自己可见'}}</text></view>
    <view class="title route-title">{{route.title}}</view>
    <view class="author-line"><view class="author-avatar">骑</view><view><view>{{route.authorName}}</view><view class="small muted">路线创作者</view></view></view>
    <view class="notice warning" wx:if="{{route.isDemo}}">示例轨迹未经实地核验，仅用于体验功能。</view>
    <view class="metrics"><view><view class="metric">{{route.distanceLabel}}<text>km</text></view><view class="muted">路线距离</view></view><view><view class="metric">{{elevationLabel}}<text wx:if="{{route.elevationGain!==null}}">m</text></view><view class="muted">累计爬升</view></view><view><view class="metric">{{stopCount}}</view><view class="muted">标记点</view></view></view>
    <view class="section-head row between"><view class="section-title">路线与标记点</view><text class="small muted">共 {{stopCount}} 站</text></view>
    <view class="timeline"><view class="step" wx:for="{{stops}}" wx:key="index"><view class="step-num">{{index+1}}</view><view><view>{{item.name}}</view><view class="small muted">{{item.role}}</view></view></view></view>
    <view class="divider"></view><view class="section-title">关于这条路</view><view class="description pre">{{route.description||'作者还没有留下说明。'}}</view>
    <view class="notice">地图展示原路书；高德会重新规划导航路线，两者可能不同。</view>
    <view class="action-grid"><button class="secondary" bindtap="exportFile" disabled="{{!exportReady}}">{{exportReady?'导出 GPX':'准备 GPX…'}}</button><button class="secondary" open-type="share" wx:if="{{canShare}}">分享路书</button></view>
    <view class="small muted section" wx:if="{{isDemo}}">体验模式的路书只在本机保存，暂不支持跨用户分享。</view>
    <view class="owner-actions section" wx:if="{{route.isOwner}}"><button class="ghost" bindtap="edit">编辑路书</button><button class="ghost delete" bindtap="remove">删除路书</button></view>
  </view>
  <view class="sticky"><button class="primary" bindtap="navigate">在高德开始导航 <text>↗</text></button></view>
</view>
<view wx:if="{{loading&&!route}}" class="empty">正在展开这条路…</view>
