.thumb{position:relative;height:330rpx;overflow:hidden;background:#0c100d}.canvas{width:100%;height:100%}.thumb-shade{position:absolute;inset:0;background:linear-gradient(180deg,transparent 52%,rgba(4,7,5,.72))}.hint{position:absolute;right:18rpx;bottom:15rpx;padding:8rpx 13rpx;border:1rpx solid #303832;border-radius:999rpx;background:rgba(9,12,10,.78);color:#98a29a;font-size:18rpx;letter-spacing:2rpx}.signal{display:inline-block;width:9rpx;height:9rpx;border-radius:50%;background:#1ed760;box-shadow:0 0 12rpx #1ed760}
